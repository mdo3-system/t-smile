# ==============================================================================
# Git Ignore Rules for Antigravity (Sumaile Project)
# GitHub 100MB単一ファイル制限 & リポジトリ容量適正化
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Scratch & Temporary test scripts/outputs
scratch/
.tempmediaStorage/
*.tmp
*.bak

# Intermediate restore HTML chunks
ch_*_final.html
chapter_*.html
clean_article_section.html
extracted_*.html
final_article_chunk_*.html
original_clean_view_*.html
perfect_restored_article.html
restored_article_feature.html
full_restored_article_feature.html
section_at_*.html
step_*_dump.txt
line17_dump.txt

# Logs & OS artifacts
*.log
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# 大容量バイナリ・参考資料・動画（GitHub 100MB制限対策 & サーバー容量最適化）
# 動画はYouTube埋め込みのみを使用するため、Gitおよび本番サーバーへの動画アップロードは完全禁止
# ==============================================================================
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv
*.srt
*.mp3
scratch_*.jpg
scratch_*.txt
scratch_*.png
screenshot_*.png
public/sample_data/jfd_survey/3D/
public/sample_data/architrend/
public/plans/*.png
public/videos/
backup/
*.patch
public/temp_chunk.js
public/test_syntax*.html

# ローカル監査・スキャン切り抜き作業フォルダ（大容量メディア除外）
public/verify_audit/
public/plans/archive_old_2d_20261104/
public/plans/preview_2473/
test_rotations/
scan2486_correct_titles/
scan2486_grids_correct/
scan2486_previews_correct/
scan2487_orient_test/
scan2487_titles_split/
scan2488_orient_test/
scan2488_titles_split/
*.png
*.jpg
!public/**/*.jpg
!public/**/*.png
!public/**/*.webp
!public/sample_data/jfd_survey/sample_docs/*.jpg

# 一時作業スクリプト
test_*.py
tune_*.py
scan_*.py
scan*.py
slice_*.py
update_*.py
verify_*.py
zero_base_*.py
self_check_*.py
sample_*.py
save_*.py
set_*.py
survey_*.py
split_*.py
sort_*.py
take_*.py
temp_*.ps1
run_*.ps1
test_*.ps1
self_check_*.ps1

# 大容量参考資料PDF（10MB〜25MB以上の印刷用元データ）
public/data/knowledge/images/*.pdf
data/thermal_knowledge/*.pdf
public/sample_data/**/*.pdf
*.pdf
# JFD敷地調査マスキング済み公開サンプル成果物（Web公開用・適正サイズ）は追跡許可
!public/sample_data/jfd_survey/sample_docs/*.pdf
!public/sample_data/jfd_survey/sample_docs/*.jpg

# 生写真アーカイブ・大容量未圧縮ソース（数GB）
raw_source_cases/
/sample_data/
cases_drawings/
!public/sample_data/jfd_survey/sample_docs/
*.raw
*.heic
*.tif
*.tiff

# 機密情報・認証トークン（Git追跡完全除外）
.env
.env.*
*secrets*.json
scripts/mail_secrets.json

# 大容量メールバックアップ（PCローカル保管専用）
email_backup/
*.eml
*.mbox

# 社内管理・日報レポート・内部ツール
data/genba_report/
data/gmail_filters.xml
google_drive_config.json
public/genba_nippo_report.html
public/data/case_photo_raw_matches.json
scripts/*yahoo_mail*.py
scripts/*gmail*.py
scripts/*genba_nippo*.py
scripts/*yahoo_attachments*.py
scripts/temp_check.js
scripts/fetch_*.py
scripts/find_*.py
scripts/inspect_*.py
scripts/update_*.py
scripts/apply_*.py
scripts/bump_*.py
scripts/verify_*.py
scripts/parse_*.py
scripts/set_*.py
scripts/add_*.py
scripts/check_*.py

public/temp_video_preview/

# 間取りスキャン・テストプレビュー除外（巨大バイナリ除外）
public/plans/recropped_*/
public/plans/preview_*/
public/plans/test_*.png
public/plans/PLAN-*-P*_*.png
public/plans/plan_*.png
*.py
